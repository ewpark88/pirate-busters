#!/usr/bin/env bash
# 커밋 전 빠른 검사: main 직접 커밋 금지, 비밀 정보, 포맷, 아키텍처·결정론, 문서 동기화, ARB 짝.
# 전체 게이트(analyze·test)는 pre-push 와 CI 가 돌린다. 설치: bash tool/install_hooks.sh
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

branch="$(git symbolic-ref --short -q HEAD || true)"
if [ "$branch" = "main" ] && [ -z "${ALLOW_MAIN_COMMIT:-}" ]; then
  echo "main 에 직접 커밋하지 않는다. feat/<단계>-<이름> 브랜치에서 작업한다 (CLAUDE.md)." >&2
  echo "머지 커밋이나 릴리스 커밋처럼 꼭 필요하면 ALLOW_MAIN_COMMIT=1 git commit ..." >&2
  exit 1
fi

dart run tool/check_secrets.dart --staged

staged_dart="$(git diff --cached --name-only --diff-filter=ACMR -- '*.dart' | grep -v '\.g\.dart$' || true)"
if [ -n "$staged_dart" ]; then
  # shellcheck disable=SC2086
  if ! dart format --output=none --set-exit-if-changed $staged_dart >/dev/null; then
    echo "포맷이 맞지 않는 파일이 있다. dart format 후 다시 스테이징한다:" >&2
    # shellcheck disable=SC2086
    dart format --output=none --set-exit-if-changed $staged_dart >&2 || true
    exit 1
  fi
fi

dart run tool/check_architecture.dart
dart run tool/check_doc_sync.dart
dart run tool/check_l10n.dart

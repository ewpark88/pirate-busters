{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash tool/verify.sh)",
      "Bash(dart run tool/*)",
      "Bash(dart test*)",
      "Bash(dart format*)",
      "Bash(dart analyze*)",
      "Bash(flutter analyze*)",
      "Bash(flutter test*)",
      "Bash(flutter pub get)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "PowerShell(powershell -File tool/verify.ps1)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(flutter pub add*)",
      "Bash(dart pub add*)",
      "Edit(/.github/workflows/**)",
      "Edit(/app/android/app/build.gradle.kts)"
    ],
    "deny": [
      "Read(**/key.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/.env*)",
      "Read(**/google-services.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --no-verify*)",
      "Bash(git config core.hooksPath*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && dart run tool/hooks/session_start.dart",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && dart run tool/hooks/format_on_edit.dart",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && dart run tool/hooks/stop_check.dart",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
